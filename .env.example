# Copy to `.env` (Bun loads it automatically); every key is read through `src/config/env.ts`.

# development | production | test (default: development)
NODE_ENV=development

# debug | info | warn | error (default: info)
LOG_LEVEL=info

# Positive integer (default: 3000)
PORT=3000

# Required, at least 32 characters. HS256 key shared with the backend that mints client tokens.
JWT_SECRET=

# Bearer key for `POST /publish`; unset disables the endpoint (404).
PUBLISH_API_KEY=

# Comma-separated browser origins allowed to connect, or `*`. Empty: any origin in development, none in production.
ALLOWED_ORIGINS=

# Trusted reverse proxies in front of the server (default: 0 = ignore X-Forwarded-For, use the socket address).
TRUST_PROXY_HOPS=0

# Unset: single instance, in-process pub/sub. Set: publishes reach subscribers on every instance.
REDIS_URL=
