# Copy to `.env` (Bun loads it automatically); every key is read through `src/config/env.ts`.

# ── App ──
# development | production | test
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
PORT=3000

# ── Auth ──
# Required, >= 32 chars (openssl rand -base64 32); HS256 key shared with the backend that mints client tokens
JWT_SECRET=
# Optional: bearer key for `POST /publish`; empty = endpoint returns 404
PUBLISH_API_KEY=

# ── Network ──
# Comma-separated browser origins, or `*`; empty = any origin in development, none in production
ALLOWED_ORIGINS=
# Reverse proxies in front of the server; 0 = ignore X-Forwarded-For and use the socket address
TRUST_PROXY_HOPS=0

# ── Scaling (Redis) ──
# Optional: empty = single instance; set = publishes reach subscribers on every instance
REDIS_URL=

# ── Dev tunnel (ngrok) ──
# For `bun run ngrok`: public URL forwarded to localhost:PORT, e.g. https://name.ngrok-free.app
BASE_URL=
